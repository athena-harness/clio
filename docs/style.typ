// Local documentation primitives; no external documentation package is required.
#let ink = rgb("#202832")
#let accent = rgb("#365fa0")
#let muted = rgb("#667180")
#let rule = rgb("#d8dee6")

#let fn-label(name) = label("fn-" + name)
#let param-label(name, parameter) = label("param-" + name + "-" + parameter)
#let fn(name) = link(fn-label(name), raw(name + "()"))
#let param(name, parameter) = link(param-label(name, parameter), raw(parameter))

#let manual-style(body) = {
  set document(title: "Clio manual", keywords: (
    "Typst",
    "physics",
    "electric field",
    "WebAssembly",
  ))
  set page(
    paper: "a4",
    margin: (x: 23mm, top: 21mm, bottom: 22mm),
    numbering: "1",
    header: context if counter(page).get().first() > 2 {
      text(size: 8pt, fill: muted)[clio #h(1fr) User guide and function
        reference]
    },
  )
  set text(font: "Libertinus Serif", size: 10pt, lang: "en", fill: ink)
  set par(justify: true, leading: 0.58em)
  set heading(numbering: none)
  set outline(indent: 0.85em)
  set table(stroke: (x: none, y: 0.4pt + rule), inset: (x: 5pt, y: 5pt))
  show table: set text(size: 8.2pt)
  show table.cell.where(y: 0): strong
  show heading.where(level: 1): set text(size: 18pt)
  show heading.where(level: 2): set text(size: 13pt)
  show heading.where(level: 3): set text(size: 10.5pt, fill: accent)
  show link: underline.with(stroke: 0.6pt + accent.lighten(65%))
  show raw: set text(font: "Cascadia Code", size: 8pt)
  show raw.where(block: true): it => block(
    width: 100%,
    fill: luma(97%),
    inset: 9pt,
    radius: 2pt,
    above: 7pt,
    below: 7pt,
    it,
  )
  show raw.where(block: false): it => context {
    let name = it.text.replace(regex("\\(\\)$"), "")
    let target = fn-label(name)
    if (
      it.text.match(regex("^[a-z][a-z-]*(\\(\\))?$")) != none
        and query(target).len() > 0
    ) {
      link(target, text(fill: accent, it))
    } else { it }
  }
  show ref: it => {
    if it.element != none and it.element.func() == heading {
      link(it.target, it.element.body)
    } else { it }
  }
  body
}

/// Display source code next to the output generated by that code's parameters.
#let code-example(code, output, caption: []) = block(
  breakable: false,
  above: 10pt,
  below: 10pt,
)[
  #table(
    columns: (1.1fr, 1fr),
    align: (left + horizon, center + horizon),
    stroke: none,
    inset: (x: 6pt, y: 4pt),
    table.header([*Typst*], [*Output*]),
    text(size: 7pt, code), output,
  )
  #if caption != [] { text(size: 8pt, fill: muted, caption) }
]

/// Render a stable function anchor, signature, return type, and parameter table.
#let api(name, signature, returns: "dictionary", parameters: (), body) = block(
  breakable: false,
  above: 9pt,
  below: 9pt,
  {
    [#heading(level: 3, raw(name + "()"))#fn-label(name)]
    block(breakable: false)[
      #raw(signature, lang: "typ", block: true)
      #text(size: 8pt, fill: muted)[Returns #raw(returns)]
    ]
    body
    if parameters.len() > 0 {
      table(
        columns: (1.05fr, 0.7fr, 1.1fr, 2.65fr),
        table.header([Parameter], [Type], [Default], [Description]),
        ..parameters
          .map(row => (
            [#raw(row.at(0))#param-label(name, row.at(0))],
            text(fill: accent, row.at(1)),
            raw(row.at(2)),
            row.at(3),
          ))
          .flatten(),
      )
    }
  },
)
